# 复制为 .env.local 后填入实际值。不要提交 .env.local。
# 以下配置全部只在服务端使用，不要添加 NEXT_PUBLIC_ 前缀。
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-with-your-secret-key
AI_MODEL=deepseek-v4-flash
AI_MAX_OUTPUT_TOKENS=1800
AI_TIMEOUT_MS=90000

# 生产环境改为你的 Cloudflare Workers 自定义域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 管理后台只允许经过 Cloudflare Access 验证且位于此列表的邮箱。
# 多个邮箱用英文逗号分隔。
ADMIN_EMAILS=admin@example.com

# ── 手相分析 ──
# Gemini 视觉特征提取（需另外申请 Gemini API Key）
# 若你的 DeepSeek 支持视觉，可去掉此处改用 DeepSeek
PALM_GEMINI_API_KEY=replace-with-your-gemini-key
PALM_GEMINI_MODEL=gemini-2.5-flash
# 报告生成复用 DeepSeek（默认回退到上方 AI_* 变量）
PALM_DEEPSEEK_BASE_URL=https://api.deepseek.com
PALM_DEEPSEEK_MODEL=deepseek-v4-flash
