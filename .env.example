# 复制为 .env.local 后填入实际值。不要提交 .env.local。
# 以下配置全部只在服务端使用，不要添加 NEXT_PUBLIC_ 前缀。
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-with-your-secret-key
AI_MODEL=deepseek-v4-flash
AI_MAX_OUTPUT_TOKENS=1800
AI_TIMEOUT_MS=90000

# 生产环境改为你的 Cloudflare Workers 自定义域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 管理后台只允许经过 Cloudflare Access 验证且位于此列表的邮箱。
# 多个邮箱用英文逗号分隔。
ADMIN_EMAILS=admin@example.com

# 仅用于部署脚本生成 D1 绑定；数据库 ID 不是浏览器运行时变量。
CLOUDFLARE_D1_DATABASE_ID=replace-with-d1-database-id
CLOUDFLARE_D1_DATABASE_NAME=ziwei-doushu-logs
